# Copie para .env e ajuste se necessário. Valores abaixo funcionam com o docker-compose.yml.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_POOL_MAX=20
LOCK_TIMEOUT_MS=2000

AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
SQS_CONSUMER_CONCURRENCY=10
SQS_VISIBILITY_TIMEOUT_S=60
SQS_MAX_RECEIVE_COUNT=5

OUTBOX_POLL_MS=500
OUTBOX_BATCH=50
OUTBOX_LEASE_MS=30000

PENDING_REFERENCE_POLL_MS=1000
PENDING_REFERENCE_TTL_MS=86400000
PENDING_REFERENCE_MAX_BACKOFF_MS=300000

SHUTDOWN_GRACE_MS=25000

# Liga/desliga os workers (outbox publisher, worker de referência, consumer SQS). Produção: true.
WORKERS_ENABLED=true

# Autenticação (ADR-011). Opcional: com false o guard é no-op. Com true, exige JWT Bearer validado
# pelo JWKS do IdP e compara o claim azp com o providerId do payload. Suba o Keycloak com
# docker compose -f docker-compose.auth.yml up -d e use os valores abaixo.
AUTH_ENABLED=false
# AUTH_JWKS_URI=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
# AUTH_ISSUER=http://localhost:8080/realms/wagering
# AUTH_AUDIENCE=

# Opcional: identifica a instância em logs e leases. Padrão: hostname + pid.
# INSTANCE_ID=

LOG_LEVEL=info

# Somente testes (NODE_ENV=test). Nunca defina em produção.
# Valores: exit_after_commit_before_ack | fail_transient
# FAULT_INJECTION=
